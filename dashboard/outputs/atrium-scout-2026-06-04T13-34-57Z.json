      "type": "Stat",
      "props": {
        "label": "Marketplace",
        "value": "34 skills"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "section_log_analyzer": {
      "type": "Stack",
