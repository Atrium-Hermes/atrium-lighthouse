      "type": "Heading",
      "props": {
        "text": "crypto",
        "level": "h4"
      }
    },
    "badge_crypto_inv": {
      "type": "Badge",
      "props": {
        "text": "2 inv",
        "variant": "outline"
      }
    },
    "alert_crypto": {
      "type": "Alert",
      "props": {
        "title": "Cost exceeds cap",
        "message": "$5 = 10× the cap. Queued for postprocess rental.",
        "type": "warning"
      }
    }
