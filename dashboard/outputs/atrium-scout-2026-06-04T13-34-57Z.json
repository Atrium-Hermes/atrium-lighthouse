    "card_main": {
      "type": "Card",
      "props": {
        "title": "Atrium Scout (06-04 run c)",
        "description": "Marketplace skill analysis and rental optimization"
      },
      "children": [
        "stack_main"
      ]
    },
    "stack_main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "section_marketplace",
        "sep1",
        "section_log_analyzer",
        "sep2",
        "section_pick",
        "sep3",
        "section_skipped"
      ]
    },
    "section_marketplace": {
      "type": "Stack",
