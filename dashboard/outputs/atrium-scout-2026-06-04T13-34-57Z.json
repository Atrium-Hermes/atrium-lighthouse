      "type": "Stat",
      "props": {
        "value": "$0.003"
      }
    },
    "text_pick_reasoning": {
      "type": "Text",
      "props": {
        "text": "Cheapest of the 1-inv cluster and the best real-loop fit (agent commits + opens PRs constantly → changelog/release-notes/semver from git history)",
        "variant": "body"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "section_skipped": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_skipped",
        "stack_crypto_info"
