    "p012-detail1": {
      "type": "Text",
      "props": {
        "text": "No failed or stuck skills"
      }
    },
    "p012-detail2": {
      "type": "Text",
      "props": {
        "text": "No open PRs or urgent issues"
      }
    },
    "p3-status": {
      "type": "Alert",
      "props": {
