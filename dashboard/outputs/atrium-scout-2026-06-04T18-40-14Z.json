      }
    },
    "semver-decide-badge": {
      "type": "Badge",
      "props": {
        "text": "Renting",
        "variant": "default"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "git-changelog-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "git-changelog-heading",
        "git-changelog-stat",
        "git-changelog-badges",
        "git-changelog-detail1",
        "git-changelog-detail2"
      ]
    },
    "git-changelog-heading": {
      "type": "Heading",
      "props": {
        "text": "git-changelog",
        "level": "h3"
      }
