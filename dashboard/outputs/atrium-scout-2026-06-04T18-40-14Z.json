{
  "root": "card-root",
  "state": {},
  "elements": {
    "card-root": {
      "type": "Card",
      "props": {
        "title": "Atrium Scout (06-04 run d)"
      },
      "children": [
        "main-stack"
      ]
    },
    "main-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "semver-decide-section",
        "sep1",
        "git-changelog-section",
        "sep2",
        "crypto-alert",
        "sep3",
        "queue-note"
      ]
    },
    "semver-decide-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
