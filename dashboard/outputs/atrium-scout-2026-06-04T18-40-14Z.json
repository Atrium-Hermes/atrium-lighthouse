    "git-changelog-badge2": {
      "type": "Badge",
      "props": {
        "text": "Reconciled",
        "variant": "secondary"
      }
    },
    "git-changelog-detail1": {
      "type": "Text",
      "props": {
        "text": "Was missing from the rentals table"
      }
    },
    "git-changelog-detail2": {
      "type": "Text",
      "props": {
        "text": "Indexer ticked 1→2 inv"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "crypto-alert": {
      "type": "Alert",
      "props": {
        "title": "crypto (2 inv)",
