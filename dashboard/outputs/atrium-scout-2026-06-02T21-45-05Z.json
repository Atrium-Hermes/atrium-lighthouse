    "separator_2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "heading_wallet": {
      "type": "Heading",
      "props": {
        "text": "Wallet Configuration",
        "level": "h2"
      }
    },
    "text_wallet_wired": {
      "type": "Text",
