    "separator_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "heading_top_pick": {
      "type": "Heading",
      "props": {
        "text": "Top Pick",
        "level": "h2"
      }
    },
    "stack_top_pick": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
