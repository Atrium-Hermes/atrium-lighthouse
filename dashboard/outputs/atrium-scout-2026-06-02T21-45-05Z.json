    "heading_status": {
      "type": "Heading",
      "props": {
        "text": "Marketplace Status",
        "level": "h2"
      }
    },
    "grid_marketplace": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
